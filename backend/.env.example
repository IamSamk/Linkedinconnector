# Optional: Serper.dev API key for 2,500 free Google X-Ray queries (zero LinkedIn traffic)
SERPER_API_KEY=

# Optional: Enable ADB carrier IP rotation when crawling in incognito on Windows/Linux
ENABLE_ADB_ROTATION=false

# SQLite Database Path
DATABASE_PATH=./osint_discovery.db

# Allowed Frontend Origin
CORS_ORIGIN=http://localhost:3000
